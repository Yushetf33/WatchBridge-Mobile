<resources>
    <!-- Tema base solo para la ventana antes de que cargue Compose (que
         aplica su propio MaterialTheme, ver Theme.kt): oscuro y con el
         mismo fondo de marca, para que no haya un parpadeo blanco al
         abrir la app. -->
    <style name="Theme.TvBridgeMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
    </style>

    <!-- Pantalla de arranque con el logo mientras Inicio carga por detrás
         (ver SplashGate y MainActivity) — al terminar, la ventana pasa al
         tema normal de arriba. -->
    <style name="Theme.TvBridgeMobile.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.TvBridgeMobile</item>
    </style>
</resources>
