<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario porque TmdbClient hace peticiones HTTP a api.themoviedb.org -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Fuerza un arranque en frío de Nuvio/Stremio antes de cada apertura
         (ver StremioLauncher.openWithFallback) — sin esto, a veces se
         quedan en la última ficha abierta en vez de navegar a la nueva. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Para poder ofrecer instalar la APK de actualización descargada
         (UpdateChecker) sin pasar por Play Store. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Para poder avisar con una notificación de que la actualización ya
         se descargó y está lista para instalar (Android 13+), y también
         para los avisos de estrenos (ver PremiereNotifier). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para volver a programar la comprobación diaria de estrenos tras un
         reinicio del dispositivo (ver BootCompletedReceiver) — las alarmas
         de AlarmManager no sobreviven un reinicio por sí solas. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- UpdateChecker.startDownload pide VISIBILITY_HIDDEN al DownloadManager
         (la propia app ya avisa cuando termina, no hace falta la notificación
         genérica del sistema) — sin este permiso, DownloadManager.enqueue()
         lanza SecurityException. -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- Sin esto, PackageManager.getPackageInfo() de cualquiera de estos
         paquetes puede devolver "no encontrado" aunque SÍ estén instalados
         (Android 11+ oculta la visibilidad de otras apps por defecto salvo
         que se declaren aquí). Necesario para StremioLauncher.isPackageInstalled
         (el aviso de "abrir en la Play Store" cuando la app de destino no
         está instalada) y para poder matar su proceso en segundo plano.
         Copiado verbatim del AndroidManifest.xml de la app de TV — pendiente
         de verificar en pruebas reales si el paquete móvil de Jellyfin/
         Wholphin/WuPlay/Plex difiere del paquete de la variante Android TV
         listada aquí (ver plan, sección 5). -->
    <queries>
        <package android:name="com.nuvio.app" />
        <package android:name="com.nuvio.tv" />
        <package android:name="com.stremio.one" />
        <package android:name="com.plexapp.android" />
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="app.wuplay.androidtv" />
        <package android:name="com.github.damontecres.wholphin" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.TvBridgeMobile">

        <!-- Reproductor de canales IPTV, a pantalla completa y en horizontal. -->
        <activity
            android:name=".IptvPlayerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.TvBridgeMobile" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TvBridgeMobile.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Compartir → TvRecommendationBridge" desde cualquier app, y el
             esquema propio tvbridge://movie/{imdbId} — ver
             ShareTargetActivity. Actividad aislada (misma idea que
             MatchPickerActivity/ConfirmOpenActivity en la app de TV): no
             comparte tarea con MainActivity, y no aparece en recientes ya
             que solo hace una resolución puntual antes de pasarle el
             resultado a MainActivity. -->
        <activity
            android:name=".ShareTargetActivity"
            android:exported="true"
            android:theme="@style/Theme.TvBridgeMobile"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tvbridge" android:host="movie" />
            </intent-filter>
        </activity>

        <!-- Recibe el aviso de DownloadManager cuando termina de bajar la
             APK de una actualización (ver UpdateChecker/UpdateDownloadReceiver).
             DOWNLOAD_COMPLETE lo emite com.android.providers.downloads, un
             proceso/UID distinto del nuestro — sin exported="true" el sistema
             bloquea la entrega en silencio. Seguro: UpdateChecker.onDownloadComplete
             ya descarta cualquier id que no sea el nuestro. -->
        <receiver
            android:name=".UpdateDownloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Comprobación diaria de estrenos (ver PremiereScheduler/
             PremiereNotifier) — disparada por una alarma interna de la
             propia app, sin componente de otro proceso implicado. -->
        <receiver
            android:name=".PremiereCheckReceiver"
            android:exported="false" />

        <!-- Aviso de "el programa está a punto de empezar" mandado desde la
             TV (ver MobileFcmService, IptvAlertNotifier) — mismo patrón que
             TvBridgeFcmService en la app de TV. -->
        <service
            android:name=".MobileFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Botón "Ver" del aviso de arriba (ver IptvAlertNotifier) — solo
             lo dispara un PendingIntent creado por esta misma app (dentro
             de la propia notificación), así que no hace falta exported="true". -->
        <receiver
            android:name=".IptvAlertVerReceiver"
            android:exported="false" />

        <!-- Vuelve a programar la alarma de arriba tras un reinicio (ver
             BootCompletedReceiver). BOOT_COMPLETED es un broadcast protegido
             del sistema (requiere RECEIVE_BOOT_COMPLETED en quien lo envía),
             así que exported="true" aquí es seguro. -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Expone la APK descargada (carpeta privada de la app) al
             instalador del sistema mediante un content:// URI, ya que un
             file:// directo está bloqueado desde Android 7. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
